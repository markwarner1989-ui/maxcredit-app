# Copy this file to ".env" for local development. On Render, set these in the
# dashboard (Environment tab) or via render.yaml instead.

# --- core ---
PORT=3000
DATA_DIR=./data
JWT_SECRET=please-change-this-to-a-long-random-string

# --- first super admin (change the password!) ---
ADMIN_EMAIL=admin@maxcreditsolution.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Super Admin

# --- business / pricing (see Scope of Work) ---
COMPANY_NAME=Max Credit Solution
COMPANY_PHONE=(855) 348-8758
SIGNUP_FEE=199
MONTHLY_FEE=199
PLAN_MONTHS=12
CANCEL_WINDOW_DAYS=14
CURRENCY=usd

# --- Stripe (leave blank to run in DEMO mode) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- Email / SMTP (leave blank to log emails to the console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Max Credit Solution <no-reply@maxcreditsolution.com>

# --- Credit engine bridge (DisputeFox / Credit Cloud) ---
CREDIT_ENGINE=disputefox
CREDIT_ENGINE_WEBHOOK=

# Public URL of the deployed app (used in email links), e.g. https://maxcredit-app.onrender.com
PUBLIC_URL=
